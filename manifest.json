{
  "name": "MiSalud",
  "short_name": "MiSalud",
  "description": "Tu bóveda médica personal — cero fricción",
  "display": "standalone",
  "start_url": "/",
  "theme_color": "#F4F7F6",
  "background_color": "#F4F7F6",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["application/pdf", "image/*"]
        }
      ]
    }
  }
}
